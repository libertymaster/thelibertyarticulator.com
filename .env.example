# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=generate-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=America/Chicago

# Development defaults. Production uses postgresql:// and redis:// URLs.
DATABASE_URL=sqlite:///db.sqlite3
CACHE_URL=locmemcache://liberty-articulator
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Public URLs
WAGTAILADMIN_BASE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=The Liberty Articulator <editor@localhost>

# FusionAuth OIDC (empty client credentials keep login disabled)
FUSIONAUTH_ISSUER=https://auth.thelibertyarticulator.com
FUSIONAUTH_CLIENT_ID=
FUSIONAUTH_CLIENT_SECRET=
FUSIONAUTH_SCOPES=openid profile email
FUSIONAUTH_ADMIN_ROLES=editors,administrators
FUSIONAUTH_MANAGED_USERS=false

# Cloudflare R2 (production media storage)
USE_R2_STORAGE=false
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=libertybucket
R2_CUSTOM_DOMAIN=assets.thelibertyarticulator.com

# Runtime
LOG_LEVEL=INFO
WEB_CONCURRENCY=4
GUNICORN_THREADS=2
FORWARDED_ALLOW_IPS=127.0.0.1
