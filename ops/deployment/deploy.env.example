# Non-secret deployment settings. Copy to /etc/liberty/deploy.env.
ALLOWED_REPOSITORY=your-org/the-liberty-articulator
ALLOWED_REF=refs/heads/main
DEPLOY_SCRIPT=/opt/liberty/ops/deployment/deploy.sh
DEPLOY_STATE_FILE=/var/lib/liberty-deploy/status.json
LISTEN_HOST=127.0.0.1
LISTEN_PORT=9080
MAX_BODY_BYTES=1048576
DEPLOY_TIMEOUT_SECONDS=1800
COMPOSE_FILE=/opt/liberty/deploy/liberty01server/compose.yaml
COMPOSE_ENV_FILE=/etc/liberty/compose.env
APP_IMAGE_REPOSITORY=ghcr.io/your-org/the-liberty-articulator
DEPLOYMENT_STATE_DIRECTORY=/var/lib/liberty-deploy
HEALTH_TIMEOUT_SECONDS=180

# Secret; load from a root-readable credential file or secret manager.
WEBHOOK_SECRET=

