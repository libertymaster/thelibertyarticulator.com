# Documentation only. Never commit populated values or source this file in production.

# GitHub production environment secrets
DEPLOY_WEBHOOK_URL=https://protected-deploy-endpoint.example/deploy
DEPLOY_WEBHOOK_SECRET=

# Optional CI/release integrations
SENTRY_AUTH_TOKEN=

# Required for trusted main/tag builds that pull the hardened DHI base images.
# Use a read-only Docker personal or organization access token.
DHI_USERNAME=
DHI_TOKEN=

# Runtime secrets belong on the servers or in a secret manager, not GitHub Actions,
# unless an approved deployment mechanism requires them.
DJANGO_SECRET_KEY=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
FUSIONAUTH_DATABASE_PASSWORD=
REDIS_PASSWORD=
FUSIONAUTH_CLIENT_SECRET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
GRAFANA_ADMIN_PASSWORD=
ALERTMANAGER_SMTP_PASSWORD=
CLOUDFLARE_TUNNEL_CREDENTIAL=
AGE_PRIVATE_IDENTITY=
