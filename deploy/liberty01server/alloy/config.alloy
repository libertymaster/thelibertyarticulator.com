logging {
  level  = "info"
  format = "json"
}

prometheus.remote_write "central" {
  endpoint {
    url = sys.env("PROMETHEUS_REMOTE_WRITE_URL")

    queue_config {
      capacity             = 10000
      max_shards           = 8
      max_samples_per_send = 2000
    }
  }

  external_labels = {
    host = sys.env("HOST_NAME"),
    tier = "application",
  }
}

prometheus.scrape "node" {
  targets         = [{ "__address__" = "node_exporter:9100", "job" = "node" }]
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "30s"
}

prometheus.scrape "containers" {
  targets         = [{ "__address__" = "cadvisor:8080", "job" = "cadvisor" }]
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "30s"
}

prometheus.scrape "traefik" {
  targets         = [{ "__address__" = "traefik:8082", "job" = "traefik" }]
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "15s"
}

prometheus.scrape "django" {
  targets = [
    { "__address__" = "web_a:8000", "instance" = "web_a", "job" = "django" },
    { "__address__" = "web_b:8000", "instance" = "web_b", "job" = "django" },
  ]
  metrics_path    = "/metrics/"
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "15s"
}

prometheus.scrape "alloy" {
  targets         = [{ "__address__" = "127.0.0.1:12345", "job" = "alloy" }]
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "30s"
}

discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.local.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    replacement  = sys.env("HOST_NAME")
    target_label = "host"
  }

  rule {
    replacement  = "application"
    target_label = "tier"
  }
}

loki.source.docker "local" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.local.targets
  relabel_rules = discovery.relabel.docker_logs.rules
  forward_to    = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = sys.env("LOKI_PUSH_URL")
  }
}
