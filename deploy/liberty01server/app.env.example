# Copy to /etc/liberty/app.env and populate from a secret manager.
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=thelibertyarticulator.com
CSRF_TRUSTED_ORIGINS=https://thelibertyarticulator.com

# Use verify-full and an application-only PostgreSQL role.
DATABASE_URL=
CACHE_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

FUSIONAUTH_ISSUER=https://auth.thelibertyarticulator.com
FUSIONAUTH_CLIENT_ID=
FUSIONAUTH_CLIENT_SECRET=

USE_R2_STORAGE=true
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=libertybucket
R2_CUSTOM_DOMAIN=assets.thelibertyarticulator.com

WAGTAILADMIN_BASE_URL=https://thelibertyarticulator.com/admin/
DEFAULT_FROM_EMAIL=The Liberty Articulator <editor@thelibertyarticulator.com>
LOG_LEVEL=INFO
FORWARDED_ALLOW_IPS=*

