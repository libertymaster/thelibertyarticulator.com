# Application image and hostname
APP_IMAGE=ghcr.io/your-org/the-liberty-articulator@sha256:replace-with-reviewed-digest
APP_ENV_FILE=/etc/liberty/app.env
PUBLIC_HOSTNAME=thelibertyarticulator.com

# Cloudflare Tunnel. The credentials JSON is secret and should be mode 0600.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_CREDENTIALS_FILE=/etc/liberty/cloudflared/credentials.json

# Private observability endpoints on liberty03server.
PROMETHEUS_REMOTE_WRITE_URL=http://liberty03.internal:9090/api/v1/write
LOKI_PUSH_URL=http://liberty03.internal:3100/loki/api/v1/push

# Workload tuning
CELERY_CONCURRENCY=4
CELERY_MAX_TASKS_PER_CHILD=500

# Optional reviewed image overrides. Prefer immutable digests in production.
TRAEFIK_IMAGE=dhi.io/traefik:3.7.11-alpine3.24
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.8.2
ALLOY_IMAGE=dhi.io/alloy:1.18.1-debian13
NODE_EXPORTER_IMAGE=dhi.io/node-exporter:1.12.1-alpine3.24
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.52.1

