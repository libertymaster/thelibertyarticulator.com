PRIVATE_BIND_ADDRESS=
OBSERVABILITY_BIND_ADDRESS=127.0.0.1

GRAFANA_ADMIN_USER=liberty-admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=https://grafana.internal

PROMETHEUS_EXTERNAL_URL=http://127.0.0.1:9090
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=80GB
ALERTMANAGER_EXTERNAL_URL=http://127.0.0.1:9093
ALERTMANAGER_CONFIG_FILE=./alertmanager/alertmanager.yml
ALERTMANAGER_SMTP_PASSWORD_FILE=/etc/liberty/alertmanager/smtp-password

# Optional reviewed image overrides. Prefer immutable digests in production.
PROMETHEUS_IMAGE=dhi.io/prometheus:3.14.0-debian13
ALERTMANAGER_IMAGE=dhi.io/alertmanager:0.34.0-debian13
LOKI_IMAGE=dhi.io/loki:3.7.6-debian13
GRAFANA_IMAGE=grafana/grafana-enterprise:13.0.7-distroless
BLACKBOX_EXPORTER_IMAGE=dhi.io/blackbox-exporter:0.28.0-alpine3.24
ALLOY_IMAGE=dhi.io/alloy:1.18.1-debian13
NODE_EXPORTER_IMAGE=dhi.io/node-exporter:1.12.1-alpine3.24
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.52.1

