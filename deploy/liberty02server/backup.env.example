# Copy to /etc/liberty/backup.env with mode 0600.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_DATABASE=liberty
FUSIONAUTH_DATABASE=fusionauth

# Public recipient only; the private age identity stays in recovery escrow.
AGE_RECIPIENT=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=
R2_PREFIX=postgres
UPLOAD_TO_R2=true
LOCAL_RETENTION_DAYS=14

