PRIVATE_BIND_ADDRESS=

# PostgreSQL administrative and application roles. All passwords are secrets.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_DATABASE=liberty
POSTGRES_APP_USER=liberty
POSTGRES_APP_PASSWORD=
FUSIONAUTH_DATABASE=fusionauth
FUSIONAUTH_DATABASE_USER=fusionauth
FUSIONAUTH_DATABASE_PASSWORD=
POSTGRES_TLS_DIR=/etc/liberty/postgres-tls
POSTGRES_LOG_MIN_DURATION_MS=1000

# Redis uses a TLS-only cache port (6379) and broker port (6380).
REDIS_PASSWORD=
REDIS_TLS_DIR=/etc/liberty/redis-tls
REDIS_CACHE_MAXMEMORY=1gb
REDIS_BROKER_MAXMEMORY=1gb

FUSIONAUTH_HOSTNAME=auth.thelibertyarticulator.com
FUSIONAUTH_APP_MEMORY=768M

PROMETHEUS_REMOTE_WRITE_URL=http://liberty03.internal:9090/api/v1/write
LOKI_PUSH_URL=http://liberty03.internal:3100/loki/api/v1/push

BACKUP_ENV_FILE=/etc/liberty/backup.env
BACKUP_OUTPUT_HOST_DIR=/var/lib/liberty/backups
BACKUP_METRICS_HOST_DIR=/var/lib/liberty/node-exporter
AGE_IDENTITY_DIR=/etc/liberty/age

# Optional reviewed image overrides. Prefer immutable digests in production.
POSTGRES_IMAGE=dhi.io/postgres:18.6-alpine3.24
REDIS_IMAGE=dhi.io/redis:8.8.2-alpine3.24
FUSIONAUTH_IMAGE=fusionauth/fusionauth-app:1.69.0
POSTGRES_EXPORTER_IMAGE=dhi.io/postgres-exporter:0.20.1-debian13
REDIS_EXPORTER_IMAGE=dhi.io/redis-exporter:1.89.0-debian13
ALLOY_IMAGE=dhi.io/alloy:1.18.1-debian13
NODE_EXPORTER_IMAGE=dhi.io/node-exporter:1.12.1-alpine3.24
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.52.1

